FROM caddy:2.11-alpine

# Runs as uid 10001 with NET_BIND_SERVICE granted in docker-compose.prod.yml —
# 80 and 443 are not negotiable for Caddy (443 serves, 80 answers the ACME
# challenge), so it gets that one capability instead of full root. /data holds
# the issued certificates and /config its autosave, both of which it must write.
RUN adduser -S -u 10001 -G root -H -s /sbin/nologin caddyapp \
 && mkdir -p /data /config \
 && chown -R 10001:0 /data /config \
 && chmod -R g+rwX /data /config
COPY caddy/Caddyfile /etc/caddy/Caddyfile
COPY web/public/ /srv/
USER 10001:0
