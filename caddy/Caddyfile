{
	email {$ACME_EMAIL:admin@localhost}
	# Keep Caddy's own footprint predictable on a 1 GiB box.
	admin off
}

{$SITE_ADDRESS} {
	encode zstd gzip

	# Cap's widget needs exactly two routes. Everything else the container
	# serves - the admin dashboard, siteverify with its secret - stays off the
	# internet; an unmatched /cap/... path just falls through to the page.
	@cap path_regexp ^/cap/[A-Za-z0-9_-]+/(challenge|redeem)$
	handle @cap {
		uri strip_prefix /cap
		reverse_proxy cap:3000
	}

	handle /api/* {
		reverse_proxy api:8000 {
			health_uri /api/health
		}
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options SAMEORIGIN
		-Server
	}

	# Access log: one JSON line per request, read by scripts/http_stats.py for
	# p95/p99 latency and error rates. Headers are dropped - nothing in them is
	# needed and they are most of each line's size. Client IPs are cut to their
	# /24 (IPv4) or /48 (IPv6): enough to spot one abusive network, not enough
	# to identify a visitor. Rotation is the json-file driver's 3 x 10 MB.
	log {
		output stdout
		format filter {
			wrap json
			fields {
				request>headers delete
				resp_headers delete
				request>remote_ip ip_mask 24 48
				request>client_ip ip_mask 24 48
			}
		}
	}
}

# Analytics dashboard and collector. The *.localhost fallback is deliberate:
# with GOATCOUNTER_HOST unset Caddy issues itself a local certificate for it
# instead of asking Let's Encrypt for a name that does not exist.
{$GOATCOUNTER_HOST:goatcounter.localhost} {
	encode zstd gzip
	reverse_proxy goatcounter:8080 {
		# Set from the real connection, so a visitor cannot forge it. GoatCounter
		# reads X-Real-IP first; it drives unique-visitor counting and countries.
		header_up X-Real-IP {remote_host}
	}
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
	log {
		output stdout
		format console
		level WARN
	}
}
