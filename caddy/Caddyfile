{
	email {$ACME_EMAIL:admin@localhost}
	# Keep Caddy's own footprint predictable on a 1 GiB box.
	admin off
}

{$SITE_ADDRESS} {
	encode zstd gzip

	# Cap's widget needs exactly two routes. Everything else the container
	# serves - the admin dashboard, siteverify with its secret - stays off the
	# internet; an unmatched /cap/... path just falls through to the page.
	@cap path_regexp ^/cap/[A-Za-z0-9_-]+/(challenge|redeem)$
	handle @cap {
		uri strip_prefix /cap
		reverse_proxy cap:3000
	}

	handle /api/* {
		reverse_proxy api:8000 {
			health_uri /api/health
		}
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options SAMEORIGIN
		-Server
	}

	log {
		output stdout
		format console
		level WARN
	}
}
