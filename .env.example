# ── AWS / S3 ──────────────────────────────────────────────────────────────────
# Leave S3_BUCKET empty to run entirely on local SQLite; everything still works,
# the site just does not publish or restore snapshots.
# On EC2, prefer an instance role and leave the key/secret blank.
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=
S3_PREFIX=are-doomers-correct

# ── Litestream (continuous SQLite replication) ───────────────────────────────
# Litestream tails the WAL and ships to S3 every SYNC_INTERVAL, so worst-case
# loss is one interval instead of one night. It needs the same S3_BUCKET and
# AWS credentials as above. Leave S3_BUCKET empty to run with no replication.
#
# Keep dev and prod on separate prefixes: pointing both at one path means two
# Litestream instances replicating different databases over each other.
LITESTREAM_S3_PREFIX=job-doomers/database.sqlite
LITESTREAM_DEV_S3_PREFIX=job-doomers-dev/database.sqlite
LITESTREAM_SYNC_INTERVAL=5m

# Superseded by Litestream; the compose files force this to false. Only set it
# true if you run the pipeline standalone, without the db-replicate container.
DB_BACKUP_TO_S3=false

# ── Site ──────────────────────────────────────────────────────────────────────
# dev only: the host port nginx binds. Prod (Caddy) always uses 80 and 443.
HTTP_PORT=8080
# prod only: the domain Caddy issues a certificate for. Use :80 to skip TLS
# (e.g. behind a load balancer that terminates it already).
SITE_ADDRESS=:80
ACME_EMAIL=
DEFAULT_COUNTRY=india

# ── Schedule ──────────────────────────────────────────────────────────────────
SCRAPE_AT=00:00
TZ=Asia/Kolkata
RUN_ON_START=true

# ── Scrape volume ─────────────────────────────────────────────────────────────
# Raise these for more coverage; they are the main driver of runtime and memory.
RESULTS_WANTED=60
HOURS_OLD=72
SCRAPE_PAUSE_SEC=3
KEEP_DESCRIPTIONS=false
# Comma-separated http://user:pass@host:port list. Strongly recommended: Naukri
# answers 406 "recaptcha required" from most datacentre and many residential IPs,
# and LinkedIn throttles hard. Watch the per-board line in the run log.
PROXIES=

# Boards to query, comma-separated. Defaults are the ones measured to actually
# return rows; glassdoor, zip_recruiter and google are excluded because they
# return nothing from an unproxied IP (see the board table in the README).
# Add them back here if they work from your network.
# SITES_INDIA=indeed,naukri,linkedin
# SITES_AUSTRALIA=indeed,linkedin
# SITES_USA=indeed,linkedin,zip_recruiter

# What gets searched for, and what counts as a "tech" role. Both have sensible
# defaults in common/config.py; override only if you mean it, because changing
# either one breaks comparability with everything collected so far.
# SEARCH_TERMS=software engineer,backend developer,data engineer
# TECH_TITLE_PATTERN=      (verbose regex, re.X - see common/config.py)
# TECH_TITLE_EXCLUDE=      (verbose regex, applied after the pattern above)

# ── Series definition ─────────────────────────────────────────────────────────
ACTIVE_WINDOW_DAYS=150
# How far back a posting date may extend the chart before our first scrape.
# Boards carry postings over a year old; without this one stale row stretches
# the x-axis across years we never observed.
RECONSTRUCT_DAYS=90

# Locations queried every night, "|"-separated. Defaults to the whole country.
# Adding metros multiplies runtime (locations x terms x sites) and shifts the
# level of the curve, so changing this mid-flight creates a visible step.
# LOCATIONS_INDIA=India|Bengaluru, Karnataka|Hyderabad, Telangana
# LOCATIONS_AUSTRALIA=Australia|Sydney, NSW|Melbourne, VIC
# LOCATIONS_USA=United States|New York, NY|San Francisco, CA

# ── Forecast ──────────────────────────────────────────────────────────────────
FORECAST_UNTIL=2027-12-31
FORECAST_MIN_POINTS=7      # below this: no forecast at all
ARIMA_MIN_POINTS=30        # first month is linear regression, then ARIMA
FORECAST_FIT_DAYS=90       # trailing window the model is fitted on
FORECAST_LOG_SPACE=true    # fit ARIMA on log(1+y): multiplicative, never negative
FORECAST_DAMPING=0.98      # 1.0 = undamped. See README before changing.
